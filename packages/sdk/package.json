{
  "name": "@everestan/protocolbanks-sdk",
  "version": "0.3.0",
  "description": "Protocol Banks SDK — agent execution, payments and invoicing for web applications",
  "homepage": "https://protocolbanks.com/docs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "keywords": [
    "crypto",
    "payments",
    "web3",
    "USDC",
    "stablecoin",
    "x402",
    "ai-agents",
    "trading",
    "hyperliquid",
    "protocol-banks"
  ],
  "author": "Protocol Banks",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/everest-an/protocolbanks-sdk.git",
    "directory": "packages/sdk"
  }
}
