{
  "name": "@everestan/protocolbanks-agent-tools",
  "version": "0.2.0",
  "description": "Tool definitions for the Protocol Banks Agent API — adapt once to the Vercel AI SDK, LangChain, OpenAI or Anthropic",
  "homepage": "https://protocolbanks.com/docs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai-agents",
    "tools",
    "function-calling",
    "langchain",
    "vercel-ai-sdk",
    "openai",
    "anthropic",
    "trading",
    "hyperliquid",
    "protocol-banks"
  ],
  "author": "Protocol Banks",
  "license": "MIT",
  "peerDependencies": {
    "@everestan/protocolbanks-sdk": ">=0.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22",
    "@everestan/protocolbanks-sdk": "workspace:*",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/everest-an/protocolbanks-sdk.git",
    "directory": "packages/agent-tools"
  }
}
